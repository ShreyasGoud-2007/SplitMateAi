# SplitMate AI — Frontend environment variables

# Backend API (replace with your computer's LAN IP)
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LOCAL_IP:8000

# Supabase project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Publishable key (or legacy anon key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY_HERE
